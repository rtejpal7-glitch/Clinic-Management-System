# Copy to .env (or run scripts/generate-env.sh). Never commit real values.
APP_ENV=development
POSTGRES_SUPERUSER_PASSWORD=change-me
CLINICFLOW_OWNER_PASSWORD=change-me
CLINICFLOW_APP_PASSWORD=change-me
# 32 random bytes, base64:  openssl rand -base64 32
DATA_ENCRYPTION_KEY=
BLIND_INDEX_KEY=
# Must be 10+ chars with letters and digits, and must not contain the username
BOOTSTRAP_ADMIN_PASSWORD=
