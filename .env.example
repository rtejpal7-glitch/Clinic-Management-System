# Copy to .env (or run scripts/generate-env.sh). Never commit real values.
APP_ENV=development
POSTGRES_SUPERUSER_PASSWORD=change-me
CLINICFLOW_OWNER_PASSWORD=change-me
CLINICFLOW_APP_PASSWORD=change-me
# 32 random bytes, base64:  openssl rand -base64 32
DATA_ENCRYPTION_KEY=
BLIND_INDEX_KEY=
# Must be 10+ chars with letters and digits, and must not contain the username
BOOTSTRAP_ADMIN_PASSWORD=

# Handwriting recognition for the doctor's writing pad (optional; see docs/HANDWRITING.md).
# none          - no recognition; the doctor types the note text (or uses iPad Scribble)
# google-vision - Google Cloud Vision; page images leave ClinicFlow (needs a data processing agreement)
# http          - your own recognition service implementing the contract in docs/HANDWRITING.md
HWR_PROVIDER=none
HWR_GOOGLE_API_KEY=
HWR_HTTP_URL=
HWR_HTTP_TOKEN=
