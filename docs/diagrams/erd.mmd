  PATIENTS {
    uuid id PK "immutable internal id"
    text patient_number UK "CF-2026-000123, immutable"
    text full_name
    date date_of_birth
    text gender
    text mobile "indexed, not unique"
    int version "optimistic lock"
  }
  PATIENT_IDENTIFIERS {
    uuid id PK
    uuid patient_id FK
    text id_type "ABHA_NUMBER | ABHA_ADDRESS"
    text value_ciphertext "AES-256-GCM"
    text value_hmac "blind index, unique when active"
    text verification_status
    bool is_mock
  }
  APPOINTMENTS {
    uuid id PK
    uuid patient_id FK
    uuid doctor_id FK
    text appointment_type
    timestamptz start_at "EXCLUDE overlap per doctor"
    timestamptz end_at
    text status
  }
  CONSULTATIONS {
    uuid id PK
    uuid appointment_id FK,UK
    text status "DRAFT | FINALIZED (locked by trigger)"
    text chief_complaint
    date follow_up_date
  }
  BILLS {
    uuid id PK
    text invoice_number UK
    bigint total_paise "CHECK total = subtotal - discount + tax"
    bigint paid_paise
    text status
  }
  AUDIT_LOGS {
    bigint id PK
    timestamptz occurred_at
    text action
    text outcome
    jsonb details
    text prev_hash
    text hash "SHA-256 chain"
  }
