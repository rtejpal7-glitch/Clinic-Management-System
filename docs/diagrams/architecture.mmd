flowchart LR
  subgraph Browser["Browser (desktop / tablet / mobile)"]
    UI["React + TypeScript SPA<br/>14 screens, hash router"]
  end
  subgraph Edge["nginx (frontend container)"]
    Static["Static assets"]
    Proxy["/api reverse proxy<br/>CSP + security headers"]
  end
  subgraph API["ClinicFlow API — C++17 / Oat++ 1.3 (modular monolith)"]
    direction TB
    Interceptors["Request body capture · JSON error handler · security headers"]
    Controllers["Controllers<br/>Auth · Admin · Patients · Scheduling · Clinical · Billing · ABDM/FHIR"]
    AuthZ["AuthService<br/>sessions · RBAC deny-by-default"]
    subgraph Services["Domain services"]
      Pat["PatientService<br/>registration · duplicates · history"]
      Sch["SchedulingService<br/>slots · appointments · queue"]
      Cli["ClinicalService<br/>EMR · e-Rx · CPOE · addenda"]
      Bil["BillingService<br/>invoices · payments · reports"]
      Adm["AdminService<br/>users · roles · settings · dashboard"]
    end
    subgraph Interop["ABDM interoperability layer"]
      Abdm["AbdmService<br/>ABHA link · consent · HI share · retries"]
      Fhir["FhirMapper<br/>FHIR R4 resources + validation"]
      Port["AbdmGateway (port)"]
      Mock["MockAbdmGateway<br/>(PoC)"]
      Live["Live adapter<br/>(future: sandbox/prod)"]
    end
    Audit["AuditService<br/>append-only, hash-chained"]
    Notify["NotificationService<br/>outbox → channel (mock log)"]
    Crypto["Crypto<br/>Argon2id · AES-256-GCM · HMAC blind index"]
    Db["Db layer (libpq)<br/>pool · parameterized SQL · transactions"]
    Worker["Background worker<br/>reminders · consent expiry · retries"]
  end
  PG[("PostgreSQL 16<br/>constraints · exclusion · triggers<br/>least-privilege app role")]
  ABDM["ABDM gateway<br/>(not connected in PoC)"]

  UI --> Static
  UI -->|HTTPS, Bearer token| Proxy --> Interceptors --> Controllers
  Controllers --> AuthZ
  Controllers --> Services
  Controllers --> Abdm
  Abdm --> Fhir
  Abdm --> Port
  Port --> Mock
  Port -.-> Live -.-> ABDM
  Services --> Audit
  Services --> Db
  Abdm --> Db
  Audit --> Db
  Sch --> Notify
  Pat --> Crypto
  Abdm --> Crypto
  Worker --> Notify
  Worker --> Abdm
  Db --> PG
